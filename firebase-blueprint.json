{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Medical appointment booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patient_id": { "type": "string" },
        "patient_name": { "type": "string" },
        "patient_phone": { "type": "string" },
        "patient_email": { "type": "string" },
        "service_id": { "type": "string" },
        "service_name": { "type": "string" },
        "service_price": { "type": "number" },
        "start_datetime": { "type": "string" },
        "end_datetime": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "pending", "completed", "cancelled", "no_show"] },
        "payment_status": { "type": "string", "enum": ["pending", "paid", "partial", "refunded"] },
        "notes": { "type": "string" },
        "origin": { "type": "string" }
      },
      "required": ["patient_name", "patient_phone", "start_datetime", "end_datetime", "status"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Clinical record and contact info for a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "dni": { "type": "string" },
        "insurance_company": { "type": "string" },
        "insurance_number": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["first_name", "last_name", "phone"]
    },
    "Service": {
      "title": "Service",
      "description": "Medical service / treatment offered by the practice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "duration_minutes": { "type": "number" },
        "description": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "price", "duration_minutes", "active"]
    },
    "PracticeSettings": {
      "title": "PracticeSettings",
      "description": "General settings and configuration for the practice",
      "type": "object",
      "properties": {
        "practice_name": { "type": "string" },
        "professional_name": { "type": "string" },
        "specialty": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp_number": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "currency": { "type": "string" },
        "subscription_plan": { "type": "string" }
      },
      "required": ["practice_name", "professional_name", "whatsapp_number"]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Patient waiting for an early cancellation slot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patient_name": { "type": "string" },
        "patient_phone": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["patient_name", "patient_phone", "priority", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered SaaS user and practice owner profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "trial_days_left": { "type": "number" },
        "trial_active": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["email", "role", "plan", "status"]
    },
    "SaasTransferSubmission": {
      "title": "SaasTransferSubmission",
      "description": "Doctor bank transfer payment proof for SaaS subscription",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "doctor_name": { "type": "string" },
        "practice_name": { "type": "string" },
        "email": { "type": "string" },
        "plan": { "type": "string" },
        "amount": { "type": "number" },
        "reference_number": { "type": "string" },
        "transfer_date": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["doctor_name", "email", "plan", "amount", "reference_number", "status"]
    },
    "AppSuggestion": {
      "title": "AppSuggestion",
      "description": "User suggestions, feature requests and feedback for app improvements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_email": { "type": "string" },
        "user_name": { "type": "string" },
        "practice_name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["new_feature", "improvement", "integration", "bug", "other"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["review", "planned", "in_progress", "completed", "declined"] },
        "upvotes": { "type": "number" },
        "upvoted_by": { "type": "array", "items": { "type": "string" } },
        "admin_reply": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["title", "description", "category", "status", "created_at"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Messages sent from the public contact form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "read", "replied", "archived"] },
        "human_verified": { "type": "boolean" },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["name", "email", "message", "created_at", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection of all registered users, clinics and superadmins"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Collection of appointments booked by patients or clinic staff"
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Directory of registered patients"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Medical services and consult aranceles"
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "#/entities/PracticeSettings" },
      "description": "Global practice configurations"
    },
    "/waitlist/{waitlistId}": {
      "schema": { "$ref": "#/entities/WaitlistEntry" },
      "description": "Smart waitlist entries"
    },
    "/saas_transfers/{transferId}": {
      "schema": { "$ref": "#/entities/SaasTransferSubmission" },
      "description": "SaaS doctor bank transfers and receipts"
    },
    "/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/AppSuggestion" },
      "description": "Collection of community and doctor suggestions and feature requests"
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Collection of public landing page and prospective client messages"
    }
  }
}
