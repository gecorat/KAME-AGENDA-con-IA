rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'gonzalocorat@gmail.com';
    }

    // Services - Public read (for booking portal), authenticated owner write
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAuthenticated();
    }

    // Practice & Reminder Settings - Public read for practice configuration (booking portal), authenticated owner write
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // Appointments - Read and write restricted by owner_id.
    // Public reservations now execute securely on the server via /api/publico/crear-reserva
    match /appointments/{appointmentId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
      allow create: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.owner_id == request.auth.uid || request.resource.data.owner_id == null));
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
    }

    // Patients - Patient management and clinical data protected per owner
    match /patients/{patientId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
      allow create: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.owner_id == request.auth.uid || request.resource.data.owner_id == null));
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
    }

    // Waitlist - Smart waitlist management
    match /waitlist/{waitlistId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
      allow create, update, delete: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.owner_id == request.auth.uid || request.resource.data.owner_id == null));
    }

    // Consultations & SOAP records
    match /consultations/{consultationId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
      allow create, update, delete: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.owner_id == request.auth.uid || request.resource.data.owner_id == null));
    }

    // Billing & Payments
    match /payments/{paymentId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
      allow create, update, delete: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.owner_id == request.auth.uid || request.resource.data.owner_id == null));
    }

    // Conversations / WhatsApp chats
    match /conversations/{conversationId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.owner_id == null));
      allow create, update, delete: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.owner_id == request.auth.uid || request.resource.data.owner_id == null));
    }

    // User profiles & SaaS Tenants
    match /users/{userId} {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow create, update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // SaaS Bank Transfers for subscription confirmations
    match /saas_transfers/{transferId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() || isSuperAdmin();
    }

    // App Suggestions & Community Feedback
    match /suggestions/{suggestionId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() || isSuperAdmin();
    }

    // Contact Messages from landing page
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() || isSuperAdmin();
    }
  }
}
