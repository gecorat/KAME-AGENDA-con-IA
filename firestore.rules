rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'gonzalocorat@gmail.com';
    }

    function isValidAppointment(data) {
      return data.patient_name is string && data.patient_name.size() > 0 &&
             data.patient_phone is string && data.patient_phone.size() > 0 &&
             data.start_datetime is string &&
             data.end_datetime is string;
    }

    // Services - Public read (for booking portal) and clinic management
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Practice Settings - Public read and practice configuration
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // Appointments - Web booking, bot reservations and staff management
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Patients - Patient management, self-booking and clinical history
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Waitlist - Smart waitlist management
    match /waitlist/{waitlistId} {
      allow read, write: if true;
    }

    // Consultations & SOAP records
    match /consultations/{consultationId} {
      allow read, write: if true;
    }

    // Billing & Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Conversations / WhatsApp chats
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // User profiles & SaaS Tenants
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
